#!/usr/bin/env python3
"""lifecycle: Claude Code hooks that record a subagent's life in the ledger, as `xs agent` events (PROTOCOL §8).

PreToolUse on Agent|Task: a spawn whose prompt names a task (T12) records agent.started, with the model and the effort.
SubagentStop (Claude Code 2.1: agent_type, agent_transcript_path): records agent.finished, or agent.stopped reason=limit when the agent's transcript ends on a usage limit.
The task is the first T<n> of the agent's prompt, or the task doing on the branch of the hook's folder. The run is the
agent's type (implementer, reviewer): a later round of the same role on the same task continues the same line.
ponytail: two agents of one role on one task at once share a run; use the agent's id when a role runs twice in parallel.

Never blocks and never prints a decision: it only records, in the background. Outside an XS repo it does nothing.

  python3 lifecycle --selftest
"""
import json, os, re, subprocess, sys

XS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "scripts", "xs")
LIMIT = re.compile(r"usage limit|rate.limit|limit reached|limit will reset", re.I)


def first_prompt(path):
    """The text of the first user message of a transcript."""
    try:
        for line in open(path):
            m = json.loads(line)
            if m.get("type") == "user":
                c = m.get("message", {}).get("content")
                return c if isinstance(c, str) else " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict))
    except (OSError, ValueError):
        pass
    return ""


def limited(path):
    """The transcript ends on the API's error of a usage limit."""
    try:
        last = json.loads([l for l in open(path) if l.strip()][-1])
    except (OSError, ValueError, IndexError):
        return False
    return bool(last.get("isApiErrorMessage")) and bool(LIMIT.search(json.dumps(last.get("message", {}))))


def task(text):
    m = re.search(r"\bT\d+\b", text or "")
    return m.group(0) if m else None


def branch(cwd):
    r = subprocess.run(["git", "-C", cwd or ".", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
    b = r.stdout.strip()
    return b if r.returncode == 0 and b not in ("HEAD", "main", "master") else None


def event(h):
    """The arguments of xs agent for this hook's input, or None."""
    name = h.get("hook_event_name")
    if name == "PreToolUse" and h.get("tool_name") in ("Agent", "Task"):
        i = h.get("tool_input", {})
        t, role = task(i.get("prompt")), i.get("subagent_type") or "general-purpose"
        if not t:
            return None
        return [t, "started", f"run={role}", f"role={role}", "tool=claude-code",
                f"model={i.get('model') or 'inherit'}", f"effort={i.get('effort') or 'medium'}"]  # the guard gives medium
    if name == "SubagentStop" and not h.get("stop_hook_active"):  # a second SubagentStop follows another hook's block: once
        tr = h.get("agent_transcript_path") or h.get("transcript_path") or ""
        role = h.get("agent_type") or "general-purpose"
        t = task(first_prompt(tr))
        where = [t] if t else ["--branch", branch(h.get("cwd"))]
        if not where[-1]:
            return None
        return where + (["stopped", f"run={role}", "reason=limit"] if limited(tr) else ["finished", f"run={role}"])
    return None


def selftest():
    import tempfile
    d = tempfile.mkdtemp()
    tr = os.path.join(d, "a.jsonl")
    line = lambda m: json.dumps(m) + "\n"
    open(tr, "w").write(line({"type": "user", "message": {"content": "Implement T12: the export."}})
                        + line({"type": "assistant", "isApiErrorMessage": True, "message": {"content": [{"text": "Claude usage limit reached."}]}}))
    spawn = {"hook_event_name": "PreToolUse", "tool_name": "Agent", "tool_input": {"prompt": "Task T7, worktree x", "subagent_type": "reviewer", "model": "opus"}}
    assert event(spawn) == ["T7", "started", "run=reviewer", "role=reviewer", "tool=claude-code", "model=opus", "effort=medium"], event(spawn)
    assert event({**spawn, "tool_input": {"prompt": "look around"}}) is None
    stop = {"hook_event_name": "SubagentStop", "agent_type": "implementer", "agent_transcript_path": tr}
    assert event(stop) == ["T12", "stopped", "run=implementer", "reason=limit"], event(stop)
    open(tr, "a").write(line({"type": "assistant", "message": {"content": [{"text": "Done: the usage limit reached test passes."}]}}))
    assert event(stop) == ["T12", "finished", "run=implementer"], event(stop)
    assert event({"hook_event_name": "SubagentStop", "agent_transcript_path": "/nonexistent", "cwd": d}) is None
    assert event({**stop, "stop_hook_active": True}) is None
    print("lifecycle: selftest ok")


def main():
    if sys.argv[1:] == ["--selftest"]:
        return selftest()
    try:
        h = json.load(sys.stdin)
        args, cwd = event(h), h.get("cwd") or "."
        top = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True).stdout.strip()
        if args and top and os.path.isdir(os.path.join(os.path.dirname(top), ".xs", "ledger")):
            subprocess.Popen([sys.executable, XS, "agent", *args], cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass  # a hook that records must never stop the session


if __name__ == "__main__":
    main()

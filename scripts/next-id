#!/usr/bin/env python3
"""next-id: the next free task, spec, ADR or memory number.

  next-id T      T336: from the ledger, where xs files every task (xs file numbers them itself)
  next-id L      L07: an entry of memory, from the ledger
  next-id S      S12: seen from every branch and worktree at once
  next-id ADR    0041: the same

Tasks and memory entries live in one ledger (the branch xs-ledger), so their numbers never collide. Specs and ADRs
live on the branches of the code: branches numbered from their own view of the folder and collided every day
(15 renumbering commits in four days). This fetches, then scans every local and remote branch and every
worktree's files, committed or not.
"""
import os, re, subprocess, sys

LEDGER = os.environ.get("XS_LEDGER", "xs-ledger")
KINDS = {"T": ("tasks", re.compile(r"^T(\d+)-"), 2, "T", True), "L": ("learnings", re.compile(r"^L(\d+)-"), 2, "L", True),
         "S": ("project/specs", re.compile(r"^S(\d+)-"), 2, "S", False), "ADR": ("project/adr", re.compile(r"^(\d{4})-"), 4, "", False)}


def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True).stdout


def names_in_ledger(folder):
    names = {os.path.basename(p) for p in git("ls-tree", "--name-only", LEDGER, folder + "/").split()}
    wt = re.match(r"worktree (.+)", git("worktree", "list", "--porcelain"))
    d = os.path.join(wt.group(1), ".xs", "ledger", folder) if wt else ""
    return names | (set(os.listdir(d)) if d and os.path.isdir(d) else set())


def names_everywhere(folder):
    names = set()
    try:  # teammates' branches count too; offline, the last fetch has to do
        subprocess.run(["git", "fetch", "-q", "--all"], capture_output=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass
    for ref in git("for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes").split():
        names |= {os.path.basename(p) for p in git("ls-tree", "--name-only", ref, folder + "/").split()}
    for wt in re.findall(r"^worktree (.+)$", git("worktree", "list", "--porcelain"), re.M):
        d = os.path.join(wt, folder)
        names |= set(os.listdir(d)) if os.path.isdir(d) else set()
    return names


def main(argv):
    if len(argv) != 1 or argv[0] not in KINDS:
        sys.exit(__doc__)
    folder, pat, width, prefix, in_ledger = KINDS[argv[0]]
    names = names_in_ledger(folder) if in_ledger else names_everywhere(folder)
    used = {int(m.group(1)) for n in names if (m := pat.match(n))}
    print(f"{prefix}{max(used | {0}) + 1:0{width}d}")


if __name__ == "__main__":
    main(sys.argv[1:])
